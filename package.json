{
  "name": "riskwise",
  "productName": "RISK WISE",
  "description": "Desktop GUI application for fully probabilistic climate risk assessment tool CLIMADA. Provides a framework for users to combine exposure, hazard and vulnerability or impact data to calculate risk.",
  "author": "Sword Group <georgios.kalomalos@sword-group.com>",
  "version": "1.0.8",
  "private": true,
  "main": "build/electron.js",
  "homepage": ".",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start:electron": "npm run build && electron .",
    "quickstart": "electron .",
    "pack": "electron-builder --dir",
    "dist": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -w",
    "publish": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -w --publish always",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@jridgewell/sourcemap-codec": "1.5.5",
    "@mui/icons-material": "9.0.0",
    "@mui/lab": "5.0.0-alpha.177",
    "@mui/material": "9.0.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "chart.js": "4.5.1",
    "chartjs-adapter-date-fns": "3.0.0",
    "d3-scale": "4.0.2",
    "d3-scale-chromatic": "3.1.0",
    "date-fns": "4.1.0",
    "electron-log": "5.4.3",
    "electron-updater": "6.8.3",
    "file-saver": "2.0.5",
    "i18next": "26.0.5",
    "leaflet": "1.9.4",
    "leaflet-simple-map-screenshoter": "0.5.0",
    "react": "19.2.5",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.2.5",
    "react-i18next": "17.0.3",
    "react-leaflet": "5.0.0",
    "svgo": "4.0.1",
    "web-vitals": "5.2.0",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.2",
    "@testing-library/dom": "^10.4.1",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "cross-env": "^10.0.0",
    "electron": "41.2.1",
    "electron-builder": "26.8.1",
    "eslint": "10.2.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "^29.0.2",
    "vite": "8.0.8",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "build": {
    "asar": false,
    "forceCodeSigning": false,
    "appId": "com.giz.riskwise",
    "productName": "RISK WISE",
    "files": [
      "build/**/*",
      "backend/**/*",
      "requirements/",
      "data/entities/",
      "data/hazards/"
    ],
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist/${version}",
      "buildResources": "assets"
    },
    "artifactName": "RiskWiseInstaller-v${version}-Setup.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "gkalomalos",
        "repo": "ERA-Project_RISK-WISE",
        "releaseType": "release"
      }
    ],
    "generateUpdatesFilesForAllChannels": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "7z",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "allowElevation": true,
      "license": "EULA.txt",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "installer/installer.nsh",
      "displayLanguageSelector": false
    },
    "_signingSkeleton": {
      "_note": "Inactive — see DECISIONS.md D17. Merge into `win` when a cert is provisioned and CSC_LINK or AZURE_* env vars are set in CI.",
      "win": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "signAndEditExecutable": true,
        "publisherName": "<org name when cert available>"
      }
    }
  }
}
